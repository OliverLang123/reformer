{
  "name": "Workout summary / Volt Ember",
  "canvas": { "width": 1080, "height": 1080, "padding": 48, "gap": 16, "format": "PNG" },
  "color": {
    "bg": "#0B0C0E",
    "tile": "#16181C",
    "tileBorder": "#23262C",
    "text": "#F3F4F6",
    "textMuted": "#8A9099",
    "textSoft": "#C9CDD3",
    "chipNeutral": "#23262C",
    "inkOnAccent": "#0B0C0E",
    "accent": "#FF6A2B",
    "accentAlternatives": { "ice": "#3DDCFF", "neon": "#FF4D9A", "ultra": "#A98BFF" },
    "derived": {
      "accentChip": "mix(accent, tile, 0.14)",
      "musclePrimary": "accent",
      "muscleSecondary": "mix(accent, tile, 0.60)",
      "muscleTertiary": "mix(accent, tile, 0.30)",
      "note": "mix(a, b, t) = per RGB channel round(a * t + b * (1 - t)). Ember values: accentChip #37231E, secondary #A24925, tertiary #5C3121."
    },
    "muscle": {
      "inactive": "#2B2E35",
      "inactiveAlt": "#272A30",
      "head": "#383C45"
    }
  },
  "font": {
    "display": "Unbounded",
    "text": "Inter Tight",
    "mono": "JetBrains Mono",
    "files": "fonts/ (woff2, latin + latin-ext, SIL OFL 1.1)"
  },
  "type": {
    "title":        { "font": "display", "size": 68, "weight": 700, "lineHeight": 1.0,  "letterSpacing": "-0.02em", "autoFitMin": 40 },
    "statValue":    { "font": "display", "size": 76, "weight": 700, "lineHeight": 0.95, "letterSpacing": "-0.03em", "autoFitMin": 24 },
    "statUnit":     { "font": "display", "size": 26, "weight": 600 },
    "prValue":      { "font": "display", "size": 40, "weight": 700, "lineHeight": 1.05, "letterSpacing": "-0.02em", "autoFitMin": 24 },
    "exerciseTop":  { "font": "display", "size": 19, "weight": 600 },
    "exerciseName": { "font": "text", "size": 23, "weight": 600, "lineHeight": 1.15, "overflow": "ellipsis" },
    "prName":       { "font": "text", "size": 24, "weight": 700, "lineHeight": 1.15, "overflow": "ellipsis" },
    "body":         { "font": "text", "size": 15, "weight": 500 },
    "legend":       { "font": "text", "size": 14, "weight": 500 },
    "pill":         { "font": "mono", "size": 14, "weight": 700, "letterSpacing": "0.08em", "uppercase": true },
    "date":         { "font": "mono", "size": 15, "weight": 500, "letterSpacing": "0.06em", "uppercase": true },
    "label":        { "font": "mono", "size": 13, "weight": 500, "letterSpacing": "0.10em", "uppercase": true },
    "equipment":    { "font": "mono", "size": 11, "weight": 500, "letterSpacing": "0.12em", "uppercase": true },
    "chip":         { "font": "mono", "size": 14, "weight": 700 },
    "badge":        { "font": "mono", "size": 11, "weight": 700, "letterSpacing": "0.08em" }
  },
  "radius": { "tile": 28, "pill": 999, "chip": 999, "badge": 6 },
  "layout": {
    "header":     { "gap": 16, "paddingBottom": 8, "pillHeight": 36 },
    "rowMain":    { "height": 608, "gap": 16 },
    "muscleTile": { "width": 480, "padding": 24, "figure": { "width": 226, "height": 449, "gap": 4, "bleed": 12 } },
    "exerciseTile": { "width": "fill (488)", "padding": [26, 28, 14, 28], "maxRows": 4, "rowGap": 16, "chipHeight": 34 },
    "rowStats":   { "height": "fill (220)", "gap": 16 },
    "volumeTile": { "width": 404, "padding": [26, 28] },
    "setsTile":   { "width": 200, "padding": [26, 24] },
    "prTile":     { "width": "fill (348)", "padding": [26, 28] }
  }
}
